# --- Django core ---
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=

# --- CORS (frontend origin) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- JWT ---
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# --- Dataset / ML ---
# Path to the training dataset (relative to backend/ or absolute)
DATASET_PATH=data/Mathernal_Risk.csv
# Model selection criterion: high_risk_recall_then_f1 | macro_f1 | accuracy
MODEL_SELECTION_CRITERION=high_risk_recall_then_f1
ML_ARTIFACTS_DIR=ml_artifacts

# --- LLM (OpenAI-compatible API). Leave empty to run in LLM-free fallback mode ---
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=45

# --- Embeddings: local (TF-IDF, offline, default) or openai (requires LLM_API_KEY) ---
EMBEDDING_BACKEND=local

# --- Vector store: local (numpy on SQLite, default) or qdrant ---
VECTOR_BACKEND=local
VECTOR_DB_URL=
VECTOR_DB_API_KEY=

# --- Email backend for password reset (configure in production) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=webmaster@aimhra.local

# --- OCR (report-card scanning; optional) ---
# Full path to tesseract.exe if not on PATH
TESSERACT_CMD=
# OCR engine: tesseract (default) | easyocr (fallback: tesseract)
OCR_ENGINE=tesseract
# Allow EasyOCR to use the GPU when available (0 = CPU only, recommended default)
OCR_ALLOW_GPU=1  # RTX 3050 present: EasyOCR runs on GPU
# Local LLM used to extract fields the regex parser missed (temp 0, keep_alive 0)
OCR_LLM_MODEL=llama3.2:3b
# Optional vision-model stage — disabled by default. Small models only!
OCR_VISION_ENABLED=0
OCR_VISION_MODEL=qwen2.5vl:3b
# With Ollama, keep at most ONE model resident so the OCR LLM/VLM and the
# chat LLM are never loaded at the same time (they unload after each call).
OLLAMA_MAX_LOADED_MODELS=1
OCR_THRESHOLD_PASS=0
# Step 3: second OCR engine (EasyOCR) cross-voting, capture gate, toggles
OCR_SECOND_ENGINE=1
OCR_MIN_WIDTH=1200
OCR_MIN_BLUR_VAR=40
OCR_ALLOW_LOW_QUALITY=0
OCR_ENABLE_QR=1
