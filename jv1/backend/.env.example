# --- Django core ---
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=

# --- CORS (frontend origin) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- JWT ---
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# --- Dataset / ML ---
# Path to the training dataset (relative to backend/ or absolute)
DATASET_PATH=data/Mathernal_Risk.csv
# Model selection criterion: high_risk_recall_then_f1 | macro_f1 | accuracy
MODEL_SELECTION_CRITERION=high_risk_recall_then_f1
ML_ARTIFACTS_DIR=ml_artifacts

# --- LLM (OpenAI-compatible API). Leave empty to run in LLM-free fallback mode ---
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=45

# --- Embeddings: local (TF-IDF, offline, default) or openai (requires LLM_API_KEY) ---
EMBEDDING_BACKEND=local

# --- Vector store: local (numpy on SQLite, default) or qdrant ---
VECTOR_BACKEND=local
VECTOR_DB_URL=
VECTOR_DB_API_KEY=

# --- Email backend for password reset (configure in production) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=webmaster@aimhra.local
